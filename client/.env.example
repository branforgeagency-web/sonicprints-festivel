# Leave blank for local development (uses Vite proxy to http://localhost:5000)
# Or set to your deployed backend URL on Render / custom domain:
VITE_API_URL=https://sonicprints-festivel.onrender.com

# Google Cloud Storage base URL for images (Leave empty for local fallback)
# Example: https://storage.googleapis.com/<your-gcp-bucket-name>
VITE_IMAGE_BASE_URL=
